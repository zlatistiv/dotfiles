// Place your key bindings in this file to override the defaults
[
    {
        "key": "ctrl+b",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "ctrl+alt+-",
        "command": "-workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "ctrl+n",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "browserforward",
        "command": "-workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "ctrl+a",
        "command": "cursorHome",
        "when": "textInputFocus"
    },
    {
        "key": "home",
        "command": "-cursorHome",
        "when": "textInputFocus"
    },
    {
        "key": "ctrl+e",
        "command": "cursorEnd",
        "when": "textInputFocus",
        "args": {
            "sticky": false
        }
    },
    {
        "key": "end",
        "command": "-cursorEnd",
        "when": "textInputFocus"
    },

	// Basic Emacs movement in the editor
	{ "key": "ctrl+a", "command": "cursorLineStart", "when": "editorTextFocus" },
	{ "key": "ctrl+e", "command": "cursorLineEnd",   "when": "editorTextFocus" },
	{ "key": "ctrl+n", "command": "cursorDown",      "when": "editorTextFocus && !suggestWidgetVisible" },
	{ "key": "ctrl+p", "command": "cursorUp",        "when": "editorTextFocus && !suggestWidgetVisible" },

	// Let ctrl+n / ctrl+p move through the autocomplete popup
	{ "key": "ctrl+n", "command": "selectNextSuggestion", "when": "suggestWidgetVisible && textInputFocus" },
	{ "key": "ctrl+p", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible && textInputFocus" },

	// ...and through Quick Open / Command Palette lists
	{ "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext",     "when": "inQuickOpen" },
	{ "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },

	// Emacs Meta keys: move and delete by word
	{ "key": "alt+f",         "command": "cursorWordEndRight",  "when": "editorTextFocus" },
	{ "key": "alt+b",         "command": "cursorWordStartLeft", "when": "editorTextFocus" },
	{ "key": "alt+d",         "command": "deleteWordRight",     "when": "editorTextFocus && !editorReadonly" },
	{ "key": "alt+backspace", "command": "deleteWordLeft",      "when": "editorTextFocus && !editorReadonly" },
]
